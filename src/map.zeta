impl<a, K, V, S, A: Allocator> Entry<'a, K, V, S, A> {
 pub fn insert(self, value: V) -> OccupiedEntry<'a, K, V, S, A> {
 match self { Entry::Occupied(mut entry) => { entry.insert(value); entry } Entry::Vacant(entry) => entry.insert_entry(value) }
 }
 
 pub fn or_insert(self, default: V) -> &mut V {
 match self { Entry::Occupied(entry) => entry.into_mut(), Entry::Vacant(entry) => entry.insert(default) }
 }
 
 pub fn or_insert_entry(self, default: V) -> OccupiedEntry<'a, K, V, S, A> {
 match self { Entry::Occupied(entry) => entry, Entry::Vacant(entry) => entry.insert_entry(default) }
 }
 
 pub fn or_insert_with(self, default: F) -> &mut V {
 match self { Entry::Occupied(entry) => entry.into_mut(), Entry::Vacant(entry) => entry.insert(default()) }
 }
 
 pub fn or_insert_with_key(self, default: F) -> &mut V {
 match self { Entry::Occupied(entry) => entry.into_mut(), Entry::Vacant(entry) => { let value = default(entry.key()); entry.insert(value) } }
 }
 
 pub fn key(&self) -> &K {
 match * self { Entry::Occupied(ref entry) => entry.key(), Entry::Vacant(ref entry) => entry.key() }
 }
 
 pub fn and_modify(self, f: F) -> Self {
 match self { Entry::Occupied(mut entry) => { f(entry.get_mut()); Entry::Occupied(entry) } Entry::Vacant(entry) => Entry::Vacant(entry) }
 }
 
 pub fn and_replace_entry_with(self, f: F) -> Self {
 match self { Entry::Occupied(entry) => entry.replace_entry_with(f), Entry::Vacant(_) => self }
 }
 
 pub fn into_map(self) -> &mut HashMap<K, V, S, A> {
 match self { Entry::Occupied(entry) => entry.table, Entry::Vacant(entry) => entry.table }
 }
 
}

impl<a, K, V: Default, S, A: Allocator> Entry<'a, K, V, S, A> {
 pub fn or_default(self) -> &mut V {
 match self { Entry::Occupied(entry) => entry.into_mut(), Entry::Vacant(entry) => entry.insert(Default::default()) }
 }
 
}

impl<a, K, V, S, A: Allocator> OccupiedEntry<'a, K, V, S, A> {
 pub fn key(&self) -> &K {
 unsafe { &self.elem.as_ref().0 }
 }
 
 pub fn replace_key(&mut self, key: K) -> K {
 assert!(self.key().equivalent(&key), "replaced key is not equivalent to the one in the entry");
 unsafe { self.replace_key_unchecked(key) }
 }
 
 pub fn replace_key_unchecked(&mut self, key: K) -> K {
 mem::replace(unsafe { &mut self.elem.as_mut().0 }, key)
 }
 
 pub fn remove_entry(self) ->(K, V) {
 unsafe { self.table.table.remove(self.elem).0 }
 }
 
 pub fn get(&self) -> &V {
 unsafe { &self.elem.as_ref().1 }
 }
 
 pub fn get_mut(&mut self) -> &mut V {
 unsafe { &mut self.elem.as_mut().1 }
 }
 
 pub fn into_mut(self) -> &mut V {
 unsafe { &mut self.elem.as_mut().1 }
 }
 
 pub fn into_entry(self) ->(&K, &mut V) {
 let _ = unsafe { self.elem.as_mut() };
 (key, val)
 }
 
 pub fn insert(&mut self, value: V) -> V {
 mem::replace(self.get_mut(), value)
 }
 
 pub fn remove(self) -> V {
 self.remove_entry().1
 }
 
 pub fn replace_entry_with(self, f: F) -> Entry<'a, K, V, S, A> {
 unsafe { let mut spare_key = None; self.table.table.replace_bucket_with(self.elem.clone(), | (key, value) | { if let Some(new_value) = f(&key, value) { Some((key, new_value)) } else { spare_key = Some(key); None } }); if let Some(key) = spare_key { Entry::Vacant(VacantEntry { hash: self.hash, key, table: self.table }) } else { Entry::Occupied(self) } }
 }
 
 pub fn into_map(self) -> &mut HashMap<K, V, S, A> {
 self.table
 }
 
}

impl<a, K, V, S, A: Allocator> VacantEntry<'a, K, V, S, A> {
 pub fn key(&self) -> &K {
 &self.key
 }
 
 pub fn into_key(self) -> K {
 self.key
 }
 
 pub fn insert(self, value: V) -> &mut V {
 let table = &mut self.table.table;
 let entry = table.insert_entry(self.hash, (self.key, value), make_hasher::<_, V, S>(&self.table.hash_builder) );
 &mut entry.1
 }
 
 pub fn insert_entry(self, value: V) -> OccupiedEntry<'a, K, V, S, A> {
 let elem = self.table.table.insert(self.hash, (self.key, value), make_hasher::<_, V, S>(&self.table.hash_builder) );
 OccupiedEntry { hash: self.hash, elem, table: self.table }
 }
 
 pub fn into_map(self) -> &mut HashMap<K, V, S, A> {
 self.table
 }
 
}

impl<a, b, K, Q: Sized, V, S, A: Allocator> EntryRef<'a, 'b, K, Q, V, S, A> {
 pub fn insert(self, value: V) -> OccupiedEntry<'a, K, V, S, A> {
 match self { EntryRef::Occupied(mut entry) => { entry.insert(value); entry } EntryRef::Vacant(entry) => entry.insert_entry(value) }
 }
 
 pub fn or_insert(self, default: V) -> &mut V {
 match self { EntryRef::Occupied(entry) => entry.into_mut(), EntryRef::Vacant(entry) => entry.insert(default) }
 }
 
 pub fn or_insert_with(self, default: F) -> &mut V {
 match self { EntryRef::Occupied(entry) => entry.into_mut(), EntryRef::Vacant(entry) => entry.insert(default()) }
 }
 
 pub fn or_insert_with_key(self, default: F) -> &mut V {
 match self { EntryRef::Occupied(entry) => entry.into_mut(), EntryRef::Vacant(entry) => { let value = default(entry.key); entry.insert(value) } }
 }
 
 pub fn key(&self) -> &Q {
 match * self { EntryRef::Occupied(ref entry) => entry.key().borrow(), EntryRef::Vacant(ref entry) => entry.key() }
 }
 
 pub fn and_modify(self, f: F) -> Self {
 match self { EntryRef::Occupied(mut entry) => { f(entry.get_mut()); EntryRef::Occupied(entry) } EntryRef::Vacant(entry) => EntryRef::Vacant(entry) }
 }
 
 pub fn into_map(self) -> &mut HashMap<K, V, S, A> {
 match self { EntryRef::Occupied(entry) => entry.table, EntryRef::Vacant(entry) => entry.table }
 }
 
}

impl<a, b, K, Q: Sized, V: Default, S, A: Allocator> EntryRef<'a, 'b, K, Q, V, S, A> {
 pub fn or_default(self) -> &mut V {
 match self { EntryRef::Occupied(entry) => entry.into_mut(), EntryRef::Vacant(entry) => entry.insert(Default::default()) }
 }
 
 pub fn or_default_entry(self) -> OccupiedEntry<'a, K, V, S, A> {
 match self { EntryRef::Occupied(entry) => entry, EntryRef::Vacant(entry) => entry.insert_entry(Default::default()) }
 }
 
}

impl<map, key, K, Q: Sized, V, S, A: Allocator> VacantEntryRef<'map, 'key, K, Q, V, S, A> {
 pub fn key(&self) -> &Q {
 self.key
 }
 
 pub fn insert(self, value: V) -> &mut V {
 let table = &mut self.table.table;
 let entry = table.insert_entry(self.hash, (self.key.to_owned(), value), make_hasher::<_, V, S>(&self.table.hash_builder) );
 &mut entry.1
 }
 
 pub fn insert_with_key(self, key: K, value: V) -> &mut V {
 self.insert_entry_with_key(key, value).into_mut()
 }
 
 pub fn insert_with_key_unchecked(self, key: K, value: V) -> &mut V {
 unsafe { self.insert_entry_with_key_unchecked(key, value) } . into_mut()
 }
 
 pub fn insert_entry(self, value: V) -> OccupiedEntry<'map, K, V, S, A> {
 let elem = self.table.table.insert(self.hash, (self.key.to_owned(), value), make_hasher::<_, V, S>(&self.table.hash_builder) );
 OccupiedEntry { hash: self.hash, elem, table: self.table }
 }
 
 pub fn insert_entry_with_key(self, key: K, value: V) -> OccupiedEntry<'map, K, V, S, A> {
 assert!((self.key).equivalent(&key), "key used for Entry creation is not equivalent to the one used for insertion");
 unsafe { self.insert_entry_with_key_unchecked(key, value) }
 }
 
 pub fn insert_entry_with_key_unchecked(self, key: K, value: V) -> OccupiedEntry<'map, K, V, S, A> {
 let elem = self.table.table.insert(self.hash, (key, value), make_hasher::<_, V, S>(&self.table.hash_builder) );
 OccupiedEntry { hash: self.hash, elem, table: self.table }
 }
 
 pub fn into_map(self) -> &mut HashMap<K, V, S, A> {
 self.table
 }
 
}

impl<K, V, S, A> FromIterator<(K, V)> for HashMap<K, V, S, A> where K: Eq + Hash, S: BuildHasher + Default, A: Default + Allocator {
 fn from_iter(iter: T) -> Self {
 let iter = iter.into_iter();
 let mut map = Self::with_capacity_and_hasher_in(iter.size_hint().0, S::default(), A::default());
 iter.for_each(| (k, v) | { map.insert(k, v); });
 map
 }
 
}

/// Inserts all new key-values from the iterator and replaces values with existing
/// keys with new values returned from the iterator.
impl<K, V, S, A> Extend<(K, V)> for HashMap<K, V, S, A> where K: Eq + Hash, S: BuildHasher, A: Allocator {
 fn extend(&mut self, iter: T) {
 let iter = iter.into_iter();
 let reserve = if self.is_empty() { iter.size_hint().0 } else { iter.size_hint().0.div_ceil(2) };
 self.reserve(reserve);
 iter.for_each(move | (k, v) | { self.insert(k, v); });
 }
 
 fn extend_one(&mut self, _: (K, V)) {
 self.insert(k, v);
 }
 
 fn extend_reserve(&mut self, additional: usize) {
 let reserve = if self.is_empty() { additional } else { additional.div_ceil(2) };
 self.reserve(reserve);
 }
 
}

/// Inserts all new key-values from the iterator and replaces values with existing
/// keys with new values returned from the iterator.
impl<a, K, V, S, A> Extend<(&K, &V)> for HashMap<K, V, S, A> where K: Eq + Hash + Copy, V: Copy, S: BuildHasher, A: Allocator {
 fn extend(&mut self, iter: T) {
 self.extend(iter.into_iter().map(| (&key, &value) | (key, value)));
 }
 
 fn extend_one(&mut self, _: (&K, &V)) {
 self.insert(*k, *v);
 }
 
 fn extend_reserve(&mut self, additional: usize) {
 Extend::<(K, V)>::extend_reserve(self, additional);
 }
 
}

/// Inserts all new key-values from the iterator and replaces values with existing
/// keys with new values returned from the iterator.
impl<a, K, V, S, A> Extend<&(K, V)> for HashMap<K, V, S, A> where K: Eq + Hash + Copy, V: Copy, S: BuildHasher, A: Allocator {
 fn extend(&mut self, iter: T) {
 self.extend(iter.into_iter().map(| & (key, value) | (key, value)));
 }
 
 fn extend_one(&mut self, _: &(K, V)) {
 self.insert(k, v);
 }
 
 fn extend_reserve(&mut self, additional: usize) {
 Extend::<(K, V)>::extend_reserve(self, additional);
 }
 
}

