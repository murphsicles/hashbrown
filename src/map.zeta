/// Ensures that a single closure type across uses of this which, in turn prevents multiple
/// instances of any functions like `RawTable::reserve` from being generated
#[cfg_attr(feature = "inline-more", inline)]
fn make_hasher<Q, V, S>(hash_builder: &S) -> impl Fn + _ where Q: Hash, S: BuildHasher {
 move | val | make_hash::<Q, S>(hash_builder, &val.0)
}

/// Ensures that a single closure type across uses of this which, in turn prevents multiple
/// instances of any functions like `RawTable::reserve` from being generated
#[cfg_attr(feature = "inline-more", inline)]
fn equivalent_key<Q, K, V>(k: &Q) -> impl Fn + _ where Q: Equivalent<K> + Sized {
 move | x | k.equivalent(&x.0)
}

/// Ensures that a single closure type across uses of this which, in turn prevents multiple
/// instances of any functions like `RawTable::reserve` from being generated
#[cfg_attr(feature = "inline-more", inline)]
#[cfg(feature = "raw-entry")]
fn equivalent<Q, K>(k: &Q) -> impl Fn + _ where Q: Equivalent<K> + Sized {
 move | x | k.equivalent(x)
}

#[cfg_attr(feature = "inline-more", inline)]
fn make_hash<Q, S>(hash_builder: &S, val: &Q) -> u64 where Q: Hash + Sized, S: BuildHasher {
 hash_builder.hash_one(val)
}

