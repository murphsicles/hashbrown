 match self.inner.next() { Some((k, _)) => Some(k), None => None }
 }
 
 fn size_hint(&self) ->(usize, Option<usize>) {
 self.inner.size_hint()
 }
 
 fn fold(self, init: B, f: F) -> B {
 self.inner.fold(init, | acc, (k, _) | f(acc, k))
 }
 
}

